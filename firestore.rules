rules_version = '2';
// 자라다 JP ONE — Firestore 보안 규칙
// 대표: 모든 원 읽기/쓰기.  원 공용 계정·선생님: "모든 원" + 자기 원 읽기, 자기 원만 쓰기.
// 원 공용 계정 목록은 index.html 의 BRANCH_BY_EMAIL 과 반드시 같게 유지하세요.
// 선생님 = portalMembers/{구글 이메일} 문서가 있고 active == true 인 구글 로그인 계정 (대표가 '직원 계정'에서 관리)
//   branches: 소속 원 목록(겸임이면 여러 개). 세 원 모두면 '3개 원 전체' — 모든 원 읽기·쓰기(금액·직원 계정 제외)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function email()     { return request.auth.token.email; }
    function isAdmin()   { return signedIn() && email() == 'jinhyuck@gmail.com' && request.auth.token.email_verified == true; }
    function sharedBranch() {
      return {
        'jarada_boys@naver.com':   'pyeongchon',
        'jarada-banpo@naver.com':  'banpo',
        'jarada-daechi@naver.com': 'daechi'
      }.get(email(), 'none');
    }
    // 선생님(개인 구글 계정)
    function isGoogle()   { return signedIn() && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function memberPath() { return /databases/$(database)/documents/portalMembers/$(email()); }
    function isStaff()    { return isGoogle() && exists(memberPath()) && get(memberPath()).data.active == true; }
    // 소속 원 목록 (예전 문서의 branch 한 개짜리 값도 인정)
    function staffHas(b)  { return get(memberPath()).data.get('branches', []).hasAny([b]) || get(memberPath()).data.get('branch', '') == b; }
    // 세 원 모두 소속 = 3개 원 전체
    function isWideStaff(){ return isStaff() && (get(memberPath()).data.get('branches', []).hasAll(['pyeongchon', 'banpo', 'daechi'])
                                                 || get(memberPath()).data.get('branch', '') == 'all'); }
    function isMyBranch(b){ return b in ['pyeongchon', 'banpo', 'daechi'] && (sharedBranch() == b || (isStaff() && staffHas(b))); }
    // JP ONE 회원 = 대표, 원 공용 계정, 등록된 선생님. 아무 Google 계정으로 로그인해도 읽을 수 없게 함
    function isMember()     { return isAdmin() || sharedBranch() != 'none' || isStaff(); }
    function validBranch(b) { return b in ['all', 'pyeongchon', 'banpo', 'daechi']; }
    function canSee(b)      { return isAdmin() || isWideStaff() || b == 'all' || isMyBranch(b); }
    function canWrite(b)    { return isAdmin() || (isWideStaff() && validBranch(b)) || isMyBranch(b); }

    // 새 문서: 작성자 이메일이 본인이어야 하고, 쓸 수 있는 원이어야 함
    function okCreate() {
      let d = request.resource.data;
      return isMember() && validBranch(d.branch) && canWrite(d.branch) && d.createdBy == email();
    }
    // 수정: 원래 원과 바뀐 원 모두 쓸 수 있어야 하고, 작성자는 못 바꿈
    function okUpdate() {
      return isMember() && canWrite(resource.data.branch)
        && validBranch(request.resource.data.branch) && canWrite(request.resource.data.branch)
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    function okDelete() { return isMember() && canWrite(resource.data.branch); }
    function okRead()   { return isMember() && canSee(resource.data.branch); }

    match /portalNotices/{id} {
      allow read: if okRead();
      allow create: if okCreate() && request.resource.data.title is string && request.resource.data.title.size() <= 100;
      allow update: if okUpdate() && request.resource.data.title.size() <= 100;
      allow delete: if okDelete();
    }
    match /portalEvents/{id} {
      allow read: if okRead();
      allow create: if okCreate() && request.resource.data.date is string && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$');
      allow update: if okUpdate();
      allow delete: if okDelete();
    }
    match /portalTodos/{id} {
      allow read: if okRead();
      // 할 일은 반드시 한 원에 속함
      allow create: if okCreate() && request.resource.data.branch != 'all';
      allow update: if okUpdate() && request.resource.data.branch != 'all';
      allow delete: if okDelete();
    }
    match /portalFiles/{id} {
      allow read: if okRead();
      allow create: if okCreate();
      allow update: if okUpdate();
      allow delete: if okDelete();
    }
    match /portalBookmarks/{id} {
      allow read: if okRead();
      allow create: if okCreate() && request.resource.data.url.matches('^https?://.*');
      allow update: if okUpdate() && request.resource.data.url.matches('^https?://.*');
      allow delete: if okDelete();
    }
    // 자료실 폴더: 모두 읽고, 대표만 추가·수정·삭제
    match /portalFolders/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin() && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow delete: if isAdmin();
    }
    // 운영지표 계산 결과: 문서 ID = 원 (pyeongchon / banpo / daechi)
    match /portalKpi/{branch} {
      allow read: if isMember() && (isAdmin() || isWideStaff() || isMyBranch(resource.data.branch));
      allow create, update: if isMember() && canWrite(branch) && branch != 'all'
        && request.resource.data.branch == branch && request.resource.data.uploadedBy == email();
      allow delete: if isAdmin();
    }
    // 운영지표 금액(미납액): 원 계정은 올리기만 하고, 읽기는 대표만
    match /portalKpiPrivate/{branch} {
      allow read: if isAdmin();
      allow create, update: if isMember() && canWrite(branch) && branch != 'all'
        && request.resource.data.branch == branch && request.resource.data.uploadedBy == email();
      allow delete: if isAdmin();
    }
    // 직원 계정: 대표만 관리. 본인은 자기 문서만 읽을 수 있음(로그인할 때 확인용)
    match /portalMembers/{mail} {
      allow get: if isAdmin() || (signedIn() && mail == email());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.branches is list && request.resource.data.branches.size() > 0
        && request.resource.data.branches.hasOnly(['pyeongchon', 'banpo', 'daechi'])
        && request.resource.data.get('branch', null) == null
        && request.resource.data.active is bool && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow delete: if isAdmin();
    }
    // 직원 생일: JP People에서 대표 화면이 자동으로 맞춤(이름·월일·원만). 같은 원 사람 + 대표가 봄
    match /portalBirthdays/{id} {
      allow read: if okRead();
      allow create, update: if isAdmin() && request.resource.data.branch in ['pyeongchon', 'banpo', 'daechi']
        && request.resource.data.md is string && request.resource.data.md.matches('^[0-9]{2}-[0-9]{2}$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow delete: if isAdmin();
    }
    // 선생님 입사월: JP People에서 대표 화면이 자동으로 맞춤(이름·입사 연월·원만). 선생님별 운영지표에서 입사한 달을 빼는 데 씀
    match /portalTeachers/{id} {
      allow read: if okRead();
      allow create, update: if isAdmin() && request.resource.data.branch in ['pyeongchon', 'banpo', 'daechi']
        && request.resource.data.startYm is string && request.resource.data.startYm.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow delete: if isAdmin();
    }
    // 업무매뉴얼: 공지와 같은 범위 규칙. 이전 내용(history)은 5개까지
    match /portalManuals/{id} {
      allow read: if okRead();
      allow create: if okCreate() && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() <= 50000;
      allow update: if okUpdate() && request.resource.data.title.size() <= 100 && request.resource.data.body.size() <= 50000
        && request.resource.data.get('history', []).size() <= 5;
      allow delete: if okDelete();
    }
    // 상담 현황: 대표 화면이 스케줄 매니저에서 최근 30일 교사별 상담 수만 세어 저장(내용·학생 이름 없음). 문서 ID = 원
    match /portalCounsel/{branch} {
      allow read: if isMember() && (isAdmin() || isWideStaff() || isMyBranch(resource.data.branch));
      allow create, update: if isAdmin() && branch in ['pyeongchon', 'banpo', 'daechi'] && request.resource.data.branch == branch;
      allow delete: if isAdmin();
    }
    match /portalBmGroups/{id} {
      allow read: if okRead();
      allow create: if okCreate() && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow update: if okUpdate() && request.resource.data.name.size() <= 20;
      allow delete: if okDelete();
    }
  }
}
