rules_version = '2';
// 자라다 JP ONE — Firestore 보안 규칙
// 대표: 모든 원 읽기/쓰기.  원 공용 계정·선생님: "모든 원" + 자기 원 읽기, 자기 원만 쓰기.
// 원 공용 계정 목록은 index.html 의 BRANCH_BY_EMAIL 과 반드시 같게 유지하세요.
// 선생님 = portalMembers/{구글 이메일} 문서가 있고 active == true 인 구글 로그인 계정 (대표가 '직원 계정'에서 관리)
//   branches: 소속 원 목록(겸임이면 여러 개). 세 원 모두면 '3개 원 전체' — 모든 원 읽기·쓰기(금액·직원 계정 제외)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function email()     { return request.auth.token.email; }
    function isAdmin()   { return signedIn() && email() == 'jinhyuck@gmail.com' && request.auth.token.email_verified == true; }
    function sharedBranch() {
      return {
        'jarada_boys@naver.com':   'pyeongchon',
        'jarada-banpo@naver.com':  'banpo',
        'jarada-daechi@naver.com': 'daechi'
      }.get(email(), 'none');
    }
    // 선생님(개인 구글 계정)
    function isGoogle()   { return signedIn() && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function memberPath() { return /databases/$(database)/documents/portalMembers/$(email()); }
    function isStaff()    { return isGoogle() && exists(memberPath()) && get(memberPath()).data.active == true; }
    // 소속 원 목록 (예전 문서의 branch 한 개짜리 값도 인정)
    function staffHas(b)  { return get(memberPath()).data.get('branches', []).hasAny([b]) || get(memberPath()).data.get('branch', '') == b; }
    // 세 원 모두 소속 = 3개 원 전체
    function isWideStaff(){ return isStaff() && (get(memberPath()).data.get('branches', []).hasAll(['pyeongchon', 'banpo', 'daechi'])
                                                 || get(memberPath()).data.get('branch', '') == 'all'); }
    function isMyBranch(b){ return b in ['pyeongchon', 'banpo', 'daechi'] && (sharedBranch() == b || (isStaff() && staffHas(b))); }
    // JP ONE 회원 = 대표, 원 공용 계정, 등록된 선생님. 아무 Google 계정으로 로그인해도 읽을 수 없게 함
    function isMember()     { return isAdmin() || sharedBranch() != 'none' || isStaff(); }
    // 워크허브 관리자 = 대표, 또는 직원 계정에서 '관리자'로 지정된 사람(원장·부원장·실장)의 소속 원
    function isManagerOf(b) { return isAdmin() || (isStaff() && get(memberPath()).data.get('manager', false) == true && staffHas(b)); }
    // 기획안 권한: 자료 담당자(따로 정하지 않으면 관리자) · 매뉴얼 승인자(대표 + 체크한 사람)
    function memData()      { return get(memberPath()).data; }
    function isCurator()    { return isAdmin() || (isStaff() && memData().get('curator', memData().get('manager', false)) == true); }
    function isApprover()   { return isAdmin() || (isStaff() && memData().get('approver', false) == true); }
    function isFolderAdmin() { return isAdmin() || (isStaff() && get(memberPath()).data.get('manager', false) == true); }
    function validBranch(b) { return b in ['all', 'pyeongchon', 'banpo', 'daechi']; }
    function canSee(b)      { return isAdmin() || isWideStaff() || b == 'all' || isMyBranch(b); }
    function canWrite(b)    { return isAdmin() || (isWideStaff() && validBranch(b)) || isMyBranch(b); }

    // 새 문서: 작성자 이메일이 본인이어야 하고, 쓸 수 있는 원이어야 함
    function okCreate() {
      let d = request.resource.data;
      return isMember() && validBranch(d.branch) && canWrite(d.branch) && d.createdBy == email();
    }
    // 수정: 원래 원과 바뀐 원 모두 쓸 수 있어야 하고, 작성자는 못 바꿈
    function okUpdate() {
      return isMember() && canWrite(resource.data.branch)
        && validBranch(request.resource.data.branch) && canWrite(request.resource.data.branch)
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    function okDelete() { return isMember() && canWrite(resource.data.branch); }
    function okRead()   { return isMember() && canSee(resource.data.branch); }

    match /portalNotices/{id} {
      allow read: if okRead();
      allow create: if okCreate() && request.resource.data.title is string && request.resource.data.title.size() <= 100;
      allow update: if okUpdate() && request.resource.data.title.size() <= 100;
      allow delete: if okDelete();
    }
    match /portalEvents/{id} {
      allow read: if okRead();
      allow create: if okCreate() && request.resource.data.date is string && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$');
      allow update: if okUpdate();
      allow delete: if okDelete();
    }
    // 월간 계획표 '이달의 계획'(날짜 없는 목표·할 일). 일정과 같은 범위 규칙
    match /portalPlans/{id} {
      allow read: if okRead();
      allow create: if okCreate() && request.resource.data.ym is string && request.resource.data.ym.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.title is string && request.resource.data.title.size() <= 80;
      allow update: if okUpdate() && request.resource.data.ym.matches('^[0-9]{4}-[0-9]{2}$') && request.resource.data.title.size() <= 80;
      allow delete: if okDelete();
    }
    match /portalTodos/{id} {
      allow read: if okRead();
      // 할 일은 반드시 한 원에 속함
      allow create: if okCreate() && request.resource.data.branch != 'all';
      allow update: if okUpdate() && request.resource.data.branch != 'all';
      allow delete: if okDelete();
    }
    // 공용 자료실: 직원 등록(임시저장·검토 요청) → 자료 담당자 확인 → 게시. 담당자가 올리면 바로 게시
    //  level(볼 수 있는 사람): all = 모두, mgr = 관리자 이상(대표 + 원장·부원장·실장), admin = 대표만
    //  status: draft 임시저장 · pending 검토 대기 · revise 보완 요청 · published 게시
    function fileLevelOk(l) { return l == 'all' || (l == 'mgr' && isFolderAdmin()) || (l == 'admin' && isAdmin()); }
    function lvSee(l)       { return l == 'all' || (l == 'mgr' && isFolderAdmin()); }
    function fileBr(b)      { return canWrite(b) || b == 'all'; }
    match /portalFiles/{id} {
      allow read: if okRead() && (isAdmin() || (resource.data.createdBy == email() && resource.data.status in ['draft', 'pending', 'revise'])
        || (resource.data.status == 'published' && lvSee(resource.data.level))
        || (resource.data.status == 'pending' && isCurator() && lvSee(resource.data.level)));
      allow create: if isMember() && validBranch(request.resource.data.branch) && fileBr(request.resource.data.branch)
        && request.resource.data.createdBy == email() && fileLevelOk(request.resource.data.level)
        && (request.resource.data.status in ['draft', 'pending'] || (request.resource.data.status == 'published' && isCurator()));
      allow update: if isAdmin()
        || (isCurator() && lvSee(resource.data.level) && fileLevelOk(request.resource.data.level)
            && fileBr(resource.data.branch) && validBranch(request.resource.data.branch) && fileBr(request.resource.data.branch)
            && request.resource.data.createdBy == resource.data.createdBy)
        || (resource.data.createdBy == email() && resource.data.status in ['draft', 'pending', 'revise']
            && request.resource.data.status in ['draft', 'pending'] && request.resource.data.createdBy == email()
            && fileLevelOk(request.resource.data.level) && validBranch(request.resource.data.branch) && fileBr(request.resource.data.branch));
      allow delete: if isAdmin()
        || (isCurator() && lvSee(resource.data.level) && fileBr(resource.data.branch))
        || (resource.data.createdBy == email() && resource.data.status != 'published');
    }
    match /portalBookmarks/{id} {
      allow read: if okRead();
      allow create: if okCreate() && request.resource.data.url.matches('^https?://.*');
      allow update: if okUpdate() && request.resource.data.url.matches('^https?://.*');
      allow delete: if okDelete();
    }
    // 자료실 분류: 모두 읽고, 자료 담당자가 추가·수정·삭제
    match /portalFolders/{id} {
      allow read: if isMember();
      allow create, update: if isCurator() && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow delete: if isCurator();
    }
    // 운영지표 계산 결과: 문서 ID = 원 (pyeongchon / banpo / daechi)
    match /portalKpi/{branch} {
      allow read: if isMember() && (isAdmin() || isWideStaff() || isMyBranch(resource.data.branch));
      allow create, update: if isMember() && canWrite(branch) && branch != 'all'
        && request.resource.data.branch == branch && request.resource.data.uploadedBy == email();
      allow delete: if isAdmin();
    }
    // 운영지표 금액(미납액): 원 계정은 올리기만 하고, 읽기는 대표만
    match /portalKpiPrivate/{branch} {
      allow read: if isAdmin();
      allow create, update: if isMember() && canWrite(branch) && branch != 'all'
        && request.resource.data.branch == branch && request.resource.data.uploadedBy == email();
      allow delete: if isAdmin();
    }
    // 직원 계정: 대표만 관리. 본인은 로그인할 때 자기 문서를 읽고, JP ONE 회원은 업무 배정용으로 목록(이름·이메일·원)을 봄
    match /portalMembers/{mail} {
      allow get: if isAdmin() || (signedIn() && mail == email()) || isMember();
      allow list: if isMember();
      allow create, update: if isAdmin() && request.resource.data.branches is list && request.resource.data.branches.size() > 0
        && request.resource.data.branches.hasOnly(['pyeongchon', 'banpo', 'daechi'])
        && request.resource.data.get('branch', null) == null
        && request.resource.data.active is bool && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.get('manager', false) is bool;
      allow delete: if isAdmin();
    }
    // 직원 생일: JP People에서 대표 화면이 자동으로 맞춤(이름·월일·원만). 같은 원 사람 + 대표가 봄
    match /portalBirthdays/{id} {
      allow read: if okRead();
      allow create, update: if isAdmin() && request.resource.data.branch in ['pyeongchon', 'banpo', 'daechi']
        && request.resource.data.md is string && request.resource.data.md.matches('^[0-9]{2}-[0-9]{2}$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow delete: if isAdmin();
    }
    // 선생님 입사월: JP People에서 대표 화면이 자동으로 맞춤(이름·입사 연월·원만). 선생님별 운영지표에서 입사한 달을 빼는 데 씀
    match /portalTeachers/{id} {
      allow read: if okRead();
      allow create, update: if isAdmin() && request.resource.data.branch in ['pyeongchon', 'banpo', 'daechi']
        && request.resource.data.startYm is string && request.resource.data.startYm.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow delete: if isAdmin();
    }
    // 업무매뉴얼(공식 기준): 자료 담당자가 쓰고 승인 요청 → 매뉴얼 승인자가 승인·게시. 게시된 뒤 담당자는 개정안(pending)만 올림
    //  모두 게시된 것만 읽고, 자료 담당자·승인자는 작성 중인 것까지 읽음. 이전 버전(history)은 5개까지
    function manOk(d) {
      return d.title is string && d.title.size() <= 100 && d.get('body', '') is string && d.get('body', '').size() <= 50000
        && d.get('type', 'text') in ['text', 'html', 'pdf'] && d.get('html', '').size() <= 900000
        && d.get('history', []).size() <= 5 && d.get('status', 'published') in ['draft', 'pending', 'published'];
    }
    match /portalManuals/{id} {
      allow read: if okRead() && (resource.data.status == 'published' || isCurator() || isApprover() || resource.data.createdBy == email());
      allow create: if okCreate() && manOk(request.resource.data)
        && (isApprover() || (isCurator() && request.resource.data.status in ['draft', 'pending']));
      allow update: if okUpdate() && manOk(request.resource.data) && (isApprover()
        || (isCurator() && resource.data.status != 'published' && request.resource.data.status in ['draft', 'pending'])
        || (isCurator() && resource.data.status == 'published'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pending', 'updatedAt', 'updatedBy'])));
      allow delete: if okDelete() && (isApprover() || (isCurator() && resource.data.status != 'published'));
    }
    // 업무매뉴얼 분류: 모두 읽고, 자료 담당자가 추가·이름 변경·순서·삭제
    match /portalManCats/{id} {
      allow read: if isMember();
      allow create, update: if isCurator() && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow delete: if isCurator();
    }
    // 필독 확인: 본인이 '확인했습니다'를 남기고, 자료 담당자·승인자는 확인 현황을 봄
    match /portalAcks/{id} {
      allow read: if isMember() && (resource.data.email == email() || isCurator() || isApprover());
      allow create, update: if isMember() && request.resource.data.email == email() && request.resource.data.manualId is string
        && request.resource.data.version is int;
      allow delete: if isAdmin();
    }
    // 수정 요청: 누구나 보내고 자기 것을 봄. 자료 담당자·승인자가 모두 보고 처리
    match /portalRequests/{id} {
      allow read: if isMember() && (resource.data.createdBy == email() || isCurator() || isApprover());
      allow create: if isMember() && request.resource.data.createdBy == email() && request.resource.data.kind in ['file', 'manual']
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && (request.resource.data.status == 'open' || isCurator() || isApprover());
      allow update: if isCurator() || isApprover();
      allow delete: if isAdmin();
    }
    // 즐겨찾기: 문서 ID = 본인 이메일, 본인만
    match /portalFavs/{mail} {
      allow read: if isMember() && resource.data.owner == email();
      allow create, update: if isMember() && mail == email() && request.resource.data.owner == email()
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 500;
      allow delete: if isMember() && mail == email();
    }
    // 상담 현황: 대표 화면이 스케줄 매니저에서 최근 30일 교사별 상담 수만 세어 저장(내용·학생 이름 없음). 문서 ID = 원
    match /portalCounsel/{branch} {
      allow read: if isMember() && (isAdmin() || isWideStaff() || isMyBranch(resource.data.branch));
      allow create, update: if isAdmin() && branch in ['pyeongchon', 'banpo', 'daechi'] && request.resource.data.branch == branch;
      allow delete: if isAdmin();
    }
    // 과거 매출(결제 매니저 장부 시작 전): 대표만 읽고 씀. 문서 ID = 원. monthly{'YYYY-MM':금액}, daily{'YYYY-MM-DD':금액}
    match /portalRevenue/{branch} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && branch in ['pyeongchon', 'banpo', 'daechi'] && request.resource.data.branch == branch
        && request.resource.data.monthly is map && request.resource.data.daily is map;
    }
    // 워크허브 업무(실행 건 하나 = 담당자 한 명). 같은 원 사람은 모두 봄(결과 공유)
    //  - 관리자: 자기 원 업무 배정·수정·확인·삭제
    //  - 누구나: 자기에게 자기 업무 추가(루틴 업무 자동 생성 포함)
    //  - 담당자: 진행 상황(체크·메모·파일·상태)만 바꿈. '확인 필요' 업무는 스스로 완료 못 함
    match /portalTasks/{id} {
      // 아직 없는 문서 확인(루틴 업무를 한 번만 만들 때)은 회원이면 허용
      allow get: if (resource == null && isMember()) || okRead();
      allow list: if okRead();
      allow create: if isMember() && request.resource.data.branch in ['pyeongchon', 'banpo', 'daechi']
        && request.resource.data.createdBy == email() && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && (isManagerOf(request.resource.data.branch) || (request.resource.data.assignee == email() && canWrite(request.resource.data.branch)));
      allow update: if isMember() && (
        (isManagerOf(resource.data.branch) && isManagerOf(request.resource.data.branch))
        || (resource.data.createdBy == email() && resource.data.assignee == email() && request.resource.data.assignee == email()
            && request.resource.data.createdBy == email() && canWrite(request.resource.data.branch))
        || (resource.data.assignee == email()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'checks', 'note', 'files', 'versions', 'log', 'submittedAt', 'doneAt', 'updatedAt', 'updatedBy'])
            && request.resource.data.status in ['todo', 'doing', 'submitted', 'done', 'revise']
            && (request.resource.data.status != 'done' || resource.data.needCheck == false)
            && (request.resource.data.status != 'revise' || resource.data.status == 'revise')));
      allow delete: if isManagerOf(resource.data.branch) || (resource.data.createdBy == email() && resource.data.assignee == email());
    }
    // 워크허브 루틴(반복 규칙): 같은 원 사람은 보고, 관리자만 만들고 고침
    match /portalRoutines/{id} {
      allow read: if okRead();
      allow create: if isManagerOf(request.resource.data.branch) && request.resource.data.branch in ['pyeongchon', 'banpo', 'daechi']
        && request.resource.data.createdBy == email() && request.resource.data.title is string && request.resource.data.title.size() <= 100;
      allow update: if isManagerOf(resource.data.branch) && isManagerOf(request.resource.data.branch);
      allow delete: if isManagerOf(resource.data.branch);
    }
    // 미션허브 미션(과제 정의): 같은 원 사람이 보고, 관리자가 만들고 고침. '모든 원' 미션은 대표만
    match /portalMissions/{id} {
      allow read: if okRead();
      allow create: if request.resource.data.createdBy == email() && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && ((request.resource.data.branch == 'all' && isAdmin()) || (request.resource.data.branch in ['pyeongchon', 'banpo', 'daechi'] && isManagerOf(request.resource.data.branch)));
      allow update, delete: if (resource.data.branch == 'all' && isAdmin()) || (resource.data.branch in ['pyeongchon', 'banpo', 'daechi'] && isManagerOf(resource.data.branch));
    }
    // 미션 평가(문서 ID = 업무 ID): 관리자는 자기 원 평가를 쓰고 봄. 교사는 자기 평가 중 '공개'된 것만 봄(다른 교사 점수는 못 봄)
    match /portalEvals/{id} {
      allow read: if isMember() && (isManagerOf(resource.data.branch) || (resource.data.teacher == email() && resource.data.published == true));
      allow create, update: if isManagerOf(request.resource.data.branch) && (resource == null || isManagerOf(resource.data.branch))
        && request.resource.data.teacher is string && request.resource.data.published is bool;
      allow delete: if isManagerOf(resource.data.branch);
    }
    // NAS 저장 작업: 교사가 자기 미션을 제출할 때 만들고, 대치원 서버 PC 커넥터(서비스 키, 규칙 밖)가 처리. 대표만 봄
    match /portalNasJobs/{id} {
      allow read: if isAdmin();
      allow create: if isMember() && request.resource.data.createdBy == email() && request.resource.data.status == 'wait'
        && (isAdmin() || get(/databases/$(database)/documents/portalTasks/$(request.resource.data.taskId)).data.assignee == email());
      allow update, delete: if isAdmin();
    }
    // NAS 커넥터 상태(커넥터가 씀): 대표만 봄
    match /portalNasStatus/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /portalBmGroups/{id} {
      allow read: if okRead();
      allow create: if okCreate() && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow update: if okUpdate() && request.resource.data.name.size() <= 20;
      allow delete: if okDelete();
    }
  }
}
