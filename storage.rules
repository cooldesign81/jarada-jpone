rules_version = '2';
// 자라다 JP ONE — Storage 보안 규칙 (자료실 파일)
// JP ONE 회원(대표 + 원 공용 계정 + 등록된 선생님)만 읽고 올릴 수 있고, 파일 하나는 100MB까지.
// 원 계정 목록은 firestore.rules · index.html 의 목록과 같게 유지하세요.
service firebase.storage {
  match /b/{bucket}/o {
    function isMember() {
      return request.auth != null && (request.auth.token.email in
        ['jinhyuck@gmail.com', 'jarada_boys@naver.com', 'jarada-banpo@naver.com', 'jarada-daechi@naver.com']
        || isStaff());
    }
    // 선생님: Firestore 직원 계정 목록(portalMembers)에 있고 사용 중인 구글 계정
    function isStaff() {
      return request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/portalMembers/$(request.auth.token.email))
        && firestore.get(/databases/(default)/documents/portalMembers/$(request.auth.token.email)).data.active == true;
    }
    // 자료실 파일: 자료 문서(portalFiles/{fileId})의 공개 범위·상태·작성자를 받기·지우기에도 똑같이 적용.
    // 자료실 문서가 아닌 파일(업무·미션 첨부, 매뉴얼 PDF)은 회원이면 됨. Firestore 문서는 평가당 2개까지만 읽음(직원 계정 + 자료 문서)
    function myEmail()  { return request.auth.token.email; }
    function isAdminS() { return myEmail() == 'jinhyuck@gmail.com' && request.auth.token.email_verified == true; }
    function memData()  { return firestore.get(/databases/(default)/documents/portalMembers/$(myEmail())).data; }
    function isMgrS()   { return isStaff() && memData().get('manager', false) == true; }
    function isCurS()   { return isStaff() && memData().get('curator', memData().get('manager', false)) == true; }
    match /portal-files/{fileId}/{name} {
      function fdoc()  { return /databases/(default)/documents/portalFiles/$(fileId); }
      function fd()    { return firestore.get(fdoc()).data; }
      function lvOk()  { return fd().get('level', 'all') == 'all' || (fd().get('level', 'all') == 'mgr' && isMgrS()); }
      function mine()  { return fd().get('createdBy', '') == myEmail(); }
      allow read: if isMember() && (isAdminS() || !firestore.exists(fdoc())
        || (fd().get('status', 'published') == 'published' && lvOk())
        || (mine() && fd().get('status', 'published') != 'published')
        || (fd().get('status', '') == 'pending' && isCurS() && lvOk()));
      allow create: if isMember() && request.resource.size < 100 * 1024 * 1024;
      // 지우기: 대표, 올린 사람, 자료 담당자. 자료실 문서가 없는 파일(업무 첨부 등)은 회원
      allow delete: if isMember() && (isAdminS() || !firestore.exists(fdoc()) || mine() || (isCurS() && lvOk()));
    }
  }
}
